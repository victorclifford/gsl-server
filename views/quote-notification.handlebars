<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Installation Quote / Assessment Request</title>
    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f8fafc;
        color: #1e293b;
      }
      .wrapper {
        width: 100%;
        background-color: #f8fafc;
        padding: 40px 20px;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        border: 1px solid #e2e8f0;
      }
      .header {
        background-color: #0f172a;
        padding: 30px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 20px;
        margin: 0;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .header p {
        color: #38bdf8;
        font-size: 11px;
        margin: 8px 0 0 0;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
      }
      .content {
        padding: 35px 30px;
      }
      .section-title {
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #64748b;
        margin-bottom: 12px;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 6px;
      }
      .info-grid {
        width: 100%;
        margin-bottom: 25px;
        border-collapse: collapse;
      }
      .info-grid td {
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 14px;
      }
      .info-grid td.label {
        font-weight: 700;
        color: #475569;
        width: 35%;
      }
      .info-grid td.value {
        color: #0f172a;
        font-weight: 500;
      }
      .highlight-box {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
      }
      .highlight-title {
        font-size: 12px;
        font-weight: 800;
        color: #166534;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0 0 8px 0;
      }
      .highlight-value {
        font-size: 15px;
        font-weight: 700;
        color: #14532d;
        margin: 0;
      }
      .highlight-sub {
        font-size: 12px;
        color: #15803d;
        margin: 4px 0 0 0;
        font-weight: 500;
      }
      .notes-box {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 25px;
        font-size: 13px;
        line-height: 1.6;
        color: #334155;
      }
      .btn-container {
        text-align: center;
        margin-top: 30px;
      }
      .btn {
        background-color: #08aa08;
        color: #ffffff;
        padding: 12px 28px;
        text-decoration: none;
        display: inline-block;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-radius: 8px;
        box-shadow: 0 2px 4px rgba(8, 170, 8, 0.2);
      }
      .footer {
        text-align: center;
        padding: 25px 30px 40px 30px;
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.5;
      }
      .footer p {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1>New Lead Alert</h1>
          <p>Go Solar Lead System</p>
        </div>

        <!-- Content -->
        <div class="content">
          <!-- Client Details -->
          <div class="section-title">Customer Information</div>
          <table class="info-grid">
            <tr>
              <td class="label">Full Name</td>
              <td class="value">{{fullName}}</td>
            </tr>
            <tr>
              <td class="label">Phone Number</td>
              <td class="value">{{phoneNumber}}</td>
            </tr>
            <tr>
              <td class="label">Email Address</td>
              <td class="value">{{email}}</td>
            </tr>
            <tr>
              <td class="label">Location</td>
              <td class="value">{{address}}, {{city}}, {{state}}</td>
            </tr>
          </table>

          <!-- Technical Specs -->
          <div class="section-title">Energy Profile & Sizing</div>
          <table class="info-grid">
            <tr>
              <td class="label">Daily Load</td>
              <td class="value">{{dailyKwh}} kWh / day</td>
            </tr>
            <tr>
              <td class="label">Peak Load</td>
              <td class="value">{{peakWatts}} W</td>
            </tr>
          </table>

          <!-- Recommendations -->
          <div class="section-title">Recommended System Setup</div>
          <div class="highlight-box">
            <h4 class="highlight-title">Inverter System Capacity</h4>
            <p class="highlight-value">{{recommendedInverter}}</p>
            <p class="highlight-sub">{{recommendedBattery}} &bull; {{recommendedPv}}</p>
          </div>

          <!-- Notes -->
          {{#if notes}}
            <div class="section-title">Inquiry Details & Comments</div>
            <div class="notes-box">
              {{notes}}
            </div>
          {{/if}}

          <!-- Dashboard Link Button -->
          <div class="btn-container">
            <a href="{{dashboardUrl}}" class="btn" style="color: #ffffff;">View in Dashboard</a>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>&copy; 2026 Go Solar Nigeria. All rights reserved.</p>
          <p style="margin-top: 5px; font-size: 11px;">This is an automated notification. Please do not reply directly to this email.</p>
        </div>
      </div>
    </div>
  </body>
</html>
